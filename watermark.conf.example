# Example watermark configuration
#
# You normally do NOT edit this file by hand — running ./setup.sh creates and
# updates `watermark.conf` for you (which is gitignored). This file is just a
# reference so you can see the available settings and their format.

# Text stamped onto every screenshot
WATERMARK_TEXT="© Your Name"

# Folder the watcher monitors for new images
WATCH_DIR="/Users/you/Desktop"

# Where the helper writes its activity log
LOG="/path/to/watermark/watermark.log"

# Path to the .ttf font used for the watermark text
FONT="/path/to/watermark/MonaSans-Regular.ttf"

# Resolved by setup.sh — paths to the binaries the watcher needs
FSWATCH_BIN="/opt/homebrew/bin/fswatch"
MAGICK_BIN="/opt/homebrew/bin/magick"
