# watermarkr — https://github.com/aleao-sl/watermarkr
# Files that should not be committed: per-user config, runtime artifacts, editor cruft.

# Personal config — created by setup.sh on each user's machine
watermarkr.conf
watermarkr.conf_bk

# Generated LaunchAgent (label includes the user's username)
com.*.watermarkr.plist

# Runtime log
watermarkr.log

# Editor / tooling
.claude/
.DS_Store
*.swp
